{
  "slack": {
    "label": "Slack",
    "type": "stdio",
    "command": "node",
    "args": ["mcp-servers/slack/node_modules/slack-mcp-server/bin/index.js", "--transport", "stdio"],
    "credential_fields": [
      {"key": "SLACK_MCP_XOXC_TOKEN", "label": "XOXC Token", "type": "password"},
      {"key": "SLACK_MCP_XOXD_TOKEN", "label": "XOXD Token", "type": "password"}
    ],
    "static_env": {"SLACK_MCP_ADD_MESSAGE_TOOL": "true"}
  },
  "imap": {
    "label": "Email (IMAP)",
    "type": "stdio",
    "command": "node",
    "args": ["mcp-servers/imap/dist/index.js"],
    "credential_fields": [],
    "exclude_tools": [
      "imap_check_spam", "imap_delete_spam", "imap_domain_stats",
      "imap_add_spam_domain", "imap_remove_spam_domain",
      "imap_add_whitelist_domain", "imap_list_spam_domains",
      "imap_add_account", "imap_remove_account"
    ],
    "account_fields": [
      {"key": "name", "label": "Account Name", "type": "text", "required": true},
      {"key": "host", "label": "IMAP Host", "type": "text", "required": true, "placeholder": "imap.gmail.com"},
      {"key": "port", "label": "Port", "type": "number", "default": 993},
      {"key": "user", "label": "Username", "type": "text", "required": true},
      {"key": "password", "label": "Password", "type": "password", "required": true},
      {"key": "tls", "label": "Use TLS", "type": "boolean", "default": true}
    ],
    "config_env": "HOME",
    "config_path": ".imap-mcp/accounts.json",
    "config_format": "imap",
    "oauth_providers": [
      {
        "id": "google",
        "label": "Gmail",
        "client_id_env": "GOOGLE_CALDAV_CLIENT_ID",
        "client_secret_env": "GOOGLE_CALDAV_CLIENT_SECRET",
        "auth_uri": "https://accounts.google.com/o/oauth2/auth",
        "token_uri": "https://oauth2.googleapis.com/token",
        "scope": "https://mail.google.com/ https://www.googleapis.com/auth/userinfo.email",
        "account_template": {
          "name": "{email}",
          "host": "imap.gmail.com",
          "port": 993,
          "tls": true,
          "auth_type": "oauth"
        }
      }
    ]
  },
  "caldav": {
    "label": "Calendar (CalDAV)",
    "type": "stdio",
    "command": "mcp-caldav",
    "args": [],
    "credential_fields": [],
    "account_fields": [
      {"key": "name", "label": "Account Name", "type": "text", "required": true},
      {"key": "url", "label": "CalDAV URL", "type": "text", "required": true, "placeholder": "https://caldav.example.com/user/calendar/"},
      {"key": "auth_type", "label": "Auth Type", "type": "select", "options": ["basic", "oauth"], "default": "basic"},
      {"key": "username", "label": "Username", "type": "text"},
      {"key": "password", "label": "Password", "type": "password"}
    ],
    "config_env": "CALDAV_ACCOUNTS_CONFIG",
    "config_format": "caldav",
    "oauth_providers": [
      {
        "id": "google",
        "label": "Google Calendar",
        "client_id_env": "GOOGLE_CALDAV_CLIENT_ID",
        "client_secret_env": "GOOGLE_CALDAV_CLIENT_SECRET",
        "auth_uri": "https://accounts.google.com/o/oauth2/auth",
        "token_uri": "https://oauth2.googleapis.com/token",
        "scope": "https://www.googleapis.com/auth/calendar https://www.googleapis.com/auth/userinfo.email",
        "account_template": {
          "auth_type": "oauth",
          "url": "https://apidata.googleusercontent.com/caldav/v2/{email}/events/"
        }
      }
    ]
  },
  "smartsheet": {
    "label": "Smartsheet",
    "type": "stdio",
    "command": "node",
    "args": ["mcp-servers/smartsheet/dist/index.js"],
    "credential_fields": [
      {"key": "SMARTSHEET_ACCESS_TOKEN", "label": "Access Token", "type": "password"}
    ]
  },
  "atlassian": {
    "label": "Atlassian (Jira/Confluence)",
    "type": "sse",
    "url": "https://mcp.atlassian.com/v1/sse",
    "credential_fields": []
  }
}
